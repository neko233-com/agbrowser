{
  "name": "agbrowser",
  "version": "0.1.25",
  "description": "Agent-first Chromium browser runtime: ad-free, multi-account, cross-channel tab sync, MCP-native",
  "license": "MIT",
  "private": false,
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/mcp",
    "packages/cli",
    "packages/console"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "desktop": "dotnet run --project packages/desktop/AgBrowser.Desktop.csproj --",
    "test:desktop": "node scripts/run-desktop-fixture.mjs --build",
    "test:dialogs": "node scripts/run-desktop-fixture.mjs --build --dialog-interaction-tests",
    "test:download-close": "node scripts/test-desktop-download-close.mjs",
    "test:download-parallel": "node scripts/test-desktop-parallel-download.mjs",
    "test:tab-close": "node scripts/test-tab-close.mjs",
    "test:favorites-manager": "node scripts/run-desktop-fixture.mjs --build --favorites-manager-benchmark",
    "test:restore-hidden": "node scripts/run-desktop-fixture.mjs --build --hidden-restore-benchmark",
    "test:restore-live": "node scripts/test-desktop-restore-live.mjs",
    "test:address-popup": "node scripts/run-desktop-fixture.mjs --build --suggestion-window-tests",
    "test:address-search": "node scripts/run-desktop-fixture.mjs --build --address-search-benchmark",
    "test:desktop-network-live": "dotnet build packages/desktop/AgBrowser.Desktop.csproj -c Release && node scripts/test-desktop-network-live.mjs",
    "test:store-extension": "node scripts/run-desktop-fixture.mjs --build --store-tests",
    "bench:desktop": "dotnet build packages/desktop.tests/AgBrowser.Desktop.Tests.csproj -c Release && node scripts/benchmark-desktop-startup.mjs",
    "bench:desktop:memory-policy": "node scripts/run-desktop-fixture.mjs --build --memory-policy-probe",
    "bench:desktop:blank-tabs": "node scripts/measure-desktop-blank-tabs.mjs",
    "bench:desktop:exe": "node scripts/benchmark-desktop-exe.mjs",
    "bench:desktop:publish": "node scripts/benchmark-publish-layout.mjs",
    "test:edge-favorites": "node --test packages/extensions/agb-edge-favorites/test/extension.test.mjs",
    "test:edge-connection": "node scripts/run-desktop-fixture.mjs --build --edge-connection-tests",
    "test:favorite-icon-live": "node scripts/test-favorite-icon-live.mjs",
    "test:find-shortcut": "node scripts/run-desktop-fixture.mjs --build --find-shortcut-tests",
    "test:browser-launch-failure": "node scripts/test-browser-launch-failure.mjs",
    "test:edge-live": "node scripts/test-edge-extension-live.mjs",
    "test:edge-bridge-live": "node scripts/run-edge-bridge-live.mjs",
    "build:msi": "node packaging/build-msi.mjs",
    "test": "npm run test:unit && npm run test:e2e && npm run test:ext && npm run test:game && npm run test:sync-live && npm run test:acceptance",
    "test:unit": "node --test --test-reporter=spec packages/core/test/rules.test.mjs packages/core/test/flags.test.mjs packages/core/test/sync.test.mjs packages/core/test/managedprofile.test.mjs packages/core/test/launcher.test.mjs packages/core/test/defaultbrowser.test.mjs packages/mcp/test/mcp.test.mjs",
    "test:e2e": "node packages/core/test/e2e.test.mjs",
    "test:ext": "node packages/core/test/extensions.test.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "doctor": "node packages/cli/bin/agb.js doctor",
    "install:mcp": "node packages/cli/bin/agb.js install",
    "postinstall": "node scripts/gen-icons.mjs",
    "test:acceptance": "node packages/mcp/test/acceptance.test.mjs",
    "test:game": "node packages/core/test/game.test.mjs",
    "test:msi": "node packaging/validate-msi.mjs",
    "test:msi-install": "powershell.exe -NoProfile -NonInteractive -File packaging/test-msi-install.ps1",
    "test:msi-registry-fixture": "powershell.exe -NoProfile -NonInteractive -File packaging/test-msi-registry-fixture.ps1",
    "test:msi-coexist": "powershell.exe -NoProfile -NonInteractive -File packaging/test-msi-coexist.ps1",
    "test:sync-live": "node --test --test-reporter=spec packages/core/test/sync-live.test.mjs",
    "verify:inheritance": "node scripts/verify-account-inheritance.mjs"
  },
  "keywords": [
    "agent",
    "browser",
    "mcp",
    "chromium",
    "chrome",
    "edge",
    "adblock",
    "automation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neko233-com/agbrowser.git"
  },
  "homepage": "https://github.com/neko233-com/agbrowser#readme",
  "bugs": {
    "url": "https://github.com/neko233-com/agbrowser/issues"
  }
}
