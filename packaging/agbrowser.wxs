<?xml version="1.0" encoding="utf-8"?>
<!-- Per-user installer for the self-contained Windows desktop application. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="agbrowser Desktop"
           Manufacturer="agbrowser"
           Version="$(var.Version)"
           UpgradeCode="B354E2D2-C816-4961-8F6D-A5CEAB83A219"
           Scope="perUser"
           Compressed="yes">

    <SummaryInformation Description="agbrowser — agent-first Chromium browser" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of agbrowser is already installed." />
    <!-- The old 0.1.0 uninstaller removes shared URL handlers. This desktop
         product has a separate upgrade identity and never removes the old MSI. -->
    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPNOREPAIR" Value="1" />
    <!-- Earlier desktop builds carried the SDK's default 1.0.0 file version.
         Always replace this product's owned files so migrating to the real
         package version cannot skip the EXE before removing the old product. -->
    <Property Id="REINSTALLMODE" Value="amus" />

    <Icon Id="agbrowserIcon" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="agbrowserIcon" />

    <!-- WixUI_InstallDir declares WIXUI_INSTALLDIR itself, so it must not be
         declared here. The default location for a silent install comes from
         the directory tree below. -->

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="agbrowser Desktop" />
    </StandardDirectory>

    <!-- Separate location permits coexistence with the legacy launcher. -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="agbrowser-desktop">
          <Directory Id="InstallAssetsFolder" Name="assets" />
        </Directory>
      </Directory>
    </StandardDirectory>
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="LauncherComponent" Guid="4B3EA2D2-EC56-4CAA-BB1C-F3961A60FF9E">
        <File Id="AgbrowserExe"
              Name="AgBrowser.Desktop.exe"
              Source="$(var.LauncherExe)"
              KeyPath="yes">
          <Shortcut Id="StartMenuShortcut"
                    Directory="ApplicationProgramsFolder"
                    Name="agbrowser"
                    Icon="agbrowserIcon"
                    WorkingDirectory="INSTALLFOLDER" />
        </File>
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\agbrowser-desktop"
                       Name="InstallFolder"
                       Type="string"
                       Value="[INSTALLFOLDER]"
                       KeyPath="no" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="AssetComponents" Directory="InstallAssetsFolder">
      <Component Id="IconComponent" Guid="BD59A974-F8E3-490E-882D-FCF46FD96BB6">
        <File Id="IconFileRef" Name="icon.ico" Source="$(var.IconFile)" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Browser registration.
         The ProgID makes agbrowser appear in Windows' "Open with" menu and in
         Settings > Apps > Default web browser. The URL associations below
         give the shell a fallback handler for http and https.

         The UserChoice key itself is protected by the Windows User Choice
         Protection Driver, so it cannot be written by an installer; the user
         makes that one confirmation in Settings. -->
    <ComponentGroup Id="BrowserRegistration" Directory="INSTALLFOLDER">
      <Component Id="ProgIdComponent" Guid="C17263BC-1355-48D7-A7C0-3B0D6F64C694">
        <RegistryKey Root="HKCU" Key="Software\Classes\Agbrowser.Document">
          <RegistryValue Id="ProgIdDescription" Type="string" Value="agbrowser HTML Document" />
          <RegistryValue Id="ProgIdUrlProtocol" Name="URL Protocol" Type="string" Value="" />
          <RegistryKey Key="DefaultIcon">
            <RegistryValue Id="ProgIdDefaultIcon" Type="string" Value="&quot;[INSTALLFOLDER]AgBrowser.Desktop.exe&quot;,0" />
          </RegistryKey>
          <RegistryKey Key="shell\open\command">
            <RegistryValue Id="ProgIdCommand" Type="string"
                           Value="&quot;[INSTALLFOLDER]AgBrowser.Desktop.exe&quot; --single-argument &quot;%1&quot;" />
          </RegistryKey>
        </RegistryKey>
      </Component>

      <Component Id="RegisteredApplicationComponent" Guid="B23E161A-96A6-4B95-8336-D61FF831FD2C">
        <RegistryValue Root="HKCU" Key="Software\RegisteredApplications" Name="agbrowser.desktop" Type="string"
                       Value="Software\Classes\Applications\AgBrowser.Desktop.exe\Capabilities" KeyPath="yes" />
      </Component>

      <Component Id="ApplicationComponent" Guid="E78930B4-4085-4C6C-A920-D4EE912AB753">
        <RegistryKey Root="HKCU" Key="Software\Classes\Applications\AgBrowser.Desktop.exe">
          <RegistryValue Id="AppPath" Name="Path" Type="string" Value="[INSTALLFOLDER]" />
          <RegistryKey Key="shell\open\command">
            <RegistryValue Id="AppCommand" Type="string"
                           Value="&quot;[INSTALLFOLDER]AgBrowser.Desktop.exe&quot; --single-argument &quot;%1&quot;" />
          </RegistryKey>
          <RegistryKey Key="Capabilities">
            <RegistryValue Id="AppName" Name="ApplicationName" Type="string" Value="agbrowser" />
            <RegistryValue Id="AppDescription" Name="ApplicationDescription" Type="string" Value="Agent-first Chromium browser" />
            <RegistryKey Key="URLAssociations">
              <RegistryValue Id="AppAssocHttp" Name="http" Type="string" Value="Agbrowser.Document" />
              <RegistryValue Id="AppAssocHttps" Name="https" Type="string" Value="Agbrowser.Document" />
            </RegistryKey>
            <RegistryKey Key="FileAssociations">
              <RegistryValue Id="AppAssocHtm" Name=".htm" Type="string" Value="Agbrowser.Document" />
              <RegistryValue Id="AppAssocHtml" Name=".html" Type="string" Value="Agbrowser.Document" />
            </RegistryKey>
          </RegistryKey>
        </RegistryKey>
      </Component>


    </ComponentGroup>

    <Feature Id="MainFeature" Title="agbrowser" Level="1" AllowAbsent="no">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentGroupRef Id="AssetComponents" />
    </Feature>

    <Feature Id="BrowserFeature" Title="Register as a web browser" Level="1">
      <ComponentGroupRef Id="BrowserRegistration" />
    </Feature>

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
  </Package>
</Wix>
