<?xml version="1.0" encoding="utf-8"?>
<!--
  agbrowser installer.

  The package is intentionally small: it ships the native launcher and the
  icon set and nothing else. The browser engine is the Chromium build already
  installed on the machine, and the agent runtime is plain JavaScript that the
  CLI resolves at run time, so there is no bundled engine to inflate the
  download.

  The MSI targets the x86 platform. That is the most compatible choice: a
  32-bit package installs on both 32-bit and 64-bit Windows and runs
  correctly under WOW64.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="agbrowser"
           Manufacturer="agbrowser"
           Version="$(var.Version)"
           UpgradeCode="7C0F2A64-9B1E-4E52-9E2D-5A3F1B8D6C40"
           Scope="perUser"
           Compressed="yes">

    <SummaryInformation Description="agbrowser — agent-first Chromium browser" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of agbrowser is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPNOREPAIR" Value="1" />

    <!-- Detect a Node.js 24+ runtime. The browser works without it; only the
         MCP server and the CLI need it. -->
    <Property Id="NODEVERSION">
      <RegistrySearch Id="NodeVersionSearch" Root="HKLM"
                      Key="SOFTWARE\Node.js\Installations\24.0.0"
                      Name="Version" Type="raw" />
    </Property>

    <Icon Id="agbrowserIcon" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="agbrowserIcon" />

    <!-- WixUI_InstallDir declares WIXUI_INSTALLDIR itself, so it must not be
         declared here. The default location for a silent install comes from
         the directory tree below. -->

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="agbrowser" />
    </StandardDirectory>

    <!-- Per-user install location: %LOCALAPPDATA%\Programs\agbrowser -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="agbrowser">
          <Directory Id="InstallAssetsFolder" Name="assets" />
        </Directory>
      </Directory>
    </StandardDirectory>
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="LauncherComponent" Guid="3F1B9E42-6C58-4A7D-9E15-0B8D2C4F7A63">
        <File Id="AgbrowserExe"
              Name="agbrowser.exe"
              Source="$(var.LauncherExe)"
              KeyPath="yes">
          <Shortcut Id="StartMenuShortcut"
                    Directory="ApplicationProgramsFolder"
                    Name="agbrowser"
                    Icon="agbrowserIcon"
                    WorkingDirectory="INSTALLFOLDER" />
        </File>
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\agbrowser"
                       Name="InstallFolder"
                       Type="string"
                       Value="[INSTALLFOLDER]"
                       KeyPath="no" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="AssetComponents" Directory="InstallAssetsFolder">
      <Component Id="IconComponent" Guid="8B4D2F71-3E9A-4C16-A7D2-5F8E9C1B4D30">
        <File Id="IconFileRef" Name="icon.ico" Source="$(var.IconFile)" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Browser registration.
         The ProgID makes agbrowser appear in Windows' "Open with" menu and in
         Settings > Apps > Default web browser. The URL associations below
         give the shell a fallback handler for http and https.

         The UserChoice key itself is protected by the Windows User Choice
         Protection Driver, so it cannot be written by an installer; the user
         makes that one confirmation in Settings. -->
    <ComponentGroup Id="BrowserRegistration" Directory="INSTALLFOLDER">
      <Component Id="ProgIdComponent" Guid="5D2F8A13-7E64-4B90-9C31-8E6B0A4F2D57">
        <RegistryKey Root="HKCU" Key="Software\Classes\AgbrowserHTML">
          <RegistryValue Id="ProgIdUrlProtocol" Name="URL Protocol" Type="string" Value="" />
          <RegistryValue Id="ProgIdDefaultIcon" Name="DefaultIcon" Type="string" Value="[INSTALLFOLDER]agbrowser.exe,0" />
          <RegistryKey Key="shell\open\command">
            <RegistryValue Id="ProgIdCommand" Name="Default" Type="string"
                           Value="&quot;[INSTALLFOLDER]agbrowser.exe&quot; --single-argument %1" />
          </RegistryKey>
        </RegistryKey>
      </Component>

      <Component Id="ApplicationComponent" Guid="3E9A6C24-1F58-4D73-8B02-5A7C4E1D9F38">
        <RegistryKey Root="HKCU" Key="Software\Classes\Applications\agbrowser.exe">
          <RegistryValue Id="AppPath" Name="Path" Type="string" Value="[INSTALLFOLDER]" />
          <RegistryKey Key="shell\open\command">
            <RegistryValue Id="AppCommand" Name="Default" Type="string"
                           Value="&quot;[INSTALLFOLDER]agbrowser.exe&quot; --single-argument %1" />
          </RegistryKey>
          <RegistryKey Key="Capabilities">
            <RegistryValue Id="AppName" Name="ApplicationName" Type="string" Value="agbrowser" />
            <RegistryValue Id="AppDescription" Name="ApplicationDescription" Type="string" Value="Agent-first Chromium browser" />
            <RegistryKey Key="URLAssociations">
              <RegistryValue Id="AppAssocHttp" Name="http" Type="string" Value="AgbrowserHTML" />
              <RegistryValue Id="AppAssocHttps" Name="https" Type="string" Value="AgbrowserHTML" />
            </RegistryKey>
          </RegistryKey>
        </RegistryKey>
      </Component>

      <Component Id="UrlAssociationComponent" Guid="7B1E4D09-6C53-4A82-B1F7-3D90E8A25C6B">
        <RegistryKey Root="HKCU" Key="Software\Classes\http">
          <RegistryValue Id="HttpUrlProtocol" Name="URL Protocol" Type="string" Value="" />
          <RegistryKey Key="shell\open\command">
            <RegistryValue Id="HttpCommand" Name="Default" Type="string"
                           Value="&quot;[INSTALLFOLDER]agbrowser.exe&quot; --single-argument %1" />
          </RegistryKey>
        </RegistryKey>
        <RegistryKey Root="HKCU" Key="Software\Classes\https">
          <RegistryValue Id="HttpsUrlProtocol" Name="URL Protocol" Type="string" Value="" />
          <RegistryKey Key="shell\open\command">
            <RegistryValue Id="HttpsCommand" Name="Default" Type="string"
                           Value="&quot;[INSTALLFOLDER]agbrowser.exe&quot; --single-argument %1" />
          </RegistryKey>
        </RegistryKey>
      </Component>
    </ComponentGroup>

    <Feature Id="MainFeature" Title="agbrowser" Level="1" AllowAbsent="no">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentGroupRef Id="AssetComponents" />
    </Feature>

    <Feature Id="BrowserFeature" Title="Register as a web browser" Level="1">
      <ComponentGroupRef Id="BrowserRegistration" />
    </Feature>

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
  </Package>
</Wix>
